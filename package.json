{
  "name": "@chromium-style-qrcode/mcp",
  "version": "1.0.0-alpha.2",
  "mcpName": "io.github.chromium-style-qrcode/mcp",
  "description": "MCP server for generating Chromium-style QR code with optional Dino logo",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "chromium-style-qrcode-mcp": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "start": "bun run src/index.ts",
    "build": "rollup -c",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write \"src/**/*.{ts,js}\"",
    "format:check": "prettier --check \"src/**/*.{ts,js}\"",
    "typecheck": "tsc --noEmit",
    "version": "node scripts/sync-version.js && git add server.json",
    "prepublishOnly": "bun run lint && bun run format:check && bun run build"
  },
  "dependencies": {
    "@chromium-style-qrcode/generator": "^1.0.2",
    "@modelcontextprotocol/sdk": "^1.0.1",
    "@napi-rs/canvas": "^0.1.65",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@rollup/plugin-commonjs": "^28.0.2",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.0",
    "@rollup/plugin-typescript": "^12.1.2",
    "@stylistic/eslint-plugin": "^2.12.1",
    "@types/node": "^22.14.0",
    "eslint": "^9.17.0",
    "eslint-import-resolver-typescript": "^3.7.0",
    "eslint-plugin-import": "^2.31.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "rollup": "^4.29.1",
    "rollup-plugin-cleanup": "^3.2.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.2"
  },
  "engines": {
    "node": ">=22.14.0"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/chromium-style-qrcode/mcp.git"
  },
  "homepage": "https://github.com/chromium-style-qrcode/mcp#readme",
  "bugs": {
    "url": "https://github.com/chromium-style-qrcode/mcp/issues"
  },
  "keywords": [
    "qrcode",
    "qr-code",
    "chromium",
    "mcp",
    "model-context-protocol"
  ],
  "author": "liuliang@w3ctech.com",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}
